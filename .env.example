# Copy this file to .env.local and fill in the values from your Supabase project:
# Dashboard > Project Settings > API Keys (and Data API for the URL).

# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server only: bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Password for the seeded demo accounts (npm run db:seed). Dev/test only.
SEED_USER_PASSWORD=choose-a-strong-password
