# Copy this file to .env.local and fill in the values from your Supabase project:
# Dashboard > Project Settings > API Keys (and Data API for the URL).

# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server only: bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Password for the seeded demo accounts (npm run db:seed). Dev/test only.
SEED_USER_PASSWORD=choose-a-strong-password

# Auth emails (confirm sign-up, reset password) are sent by the app with
# Nodemailer over SMTP. Gmail: smtp.gmail.com, port 465, your address, and an
# App Password (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM="MedEase <you@gmail.com>"

# Optional: TURN relay for video calls on strict networks (comma-separated
# URLs, e.g. turn:turn.example.com:3478). Leave unset to use free STUN only.
# TURN_URLS=
# TURN_USERNAME=
# TURN_CREDENTIAL=
