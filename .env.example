# Copy this file to .env.local and fill in the values from your Supabase project:
# Dashboard > Project Settings > API Keys (and Data API for the URL).

# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server only: bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Public address of the app, used for links in emails (never taken from the
# request). Required in production, where the server won't start without it;
# https only. Defaults to http://localhost:3000 in development.
SITE_URL=http://localhost:3000

# Password for the seeded demo accounts (npm run db:seed). Dev/test only.
SEED_USER_PASSWORD=choose-a-strong-password
# npm run db:seed only runs against the project named here (the part before
# .supabase.co), or a local Supabase. Never set it to the production project.
SEED_PROJECT_REF=your-project-ref

# Auth emails (confirm sign-up, reset password) are sent by the app with
# Nodemailer over SMTP. Gmail: smtp.gmail.com, port 465, your address, and an
# App Password (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM="MedEase <you@gmail.com>"

# Optional: TURN relay for video calls on strict networks (comma-separated
# URLs, e.g. turn:turn.example.com:3478). Leave unset to use free STUN only.
# TURN_URLS=
# TURN_USERNAME=
# TURN_CREDENTIAL=
